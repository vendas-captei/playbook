{
  "crons": [
    {
      "path": "/api/fc-history?dataset=accuracy&refresh=1&persist=1",
      "schedule": "5 3 * * *"
    }
  ],
  "routes": [
    { "src": "/users\\.json", "status": 403 },
    { "src": "/(metas|params|fccommit|fcparams)\\.json", "status": 403 },
    { "src": "/data/(history|filters|daily|forecast-[a-z-]+)\\.json", "status": 403 },
    { "handle": "filesystem" }
  ]
}
