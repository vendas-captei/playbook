{
  "hosting": {
    "site": "playbook-comercial-18c7a",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".github/**",
      "**/node_modules/**",
      "functions/**",
      "vercel.json",
      "api/**",
      "lib/**",
      "users.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}
