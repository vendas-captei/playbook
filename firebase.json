{
  "hosting": {
    "site": "playbook-comercial-18c7a",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".github/**",
      "**/node_modules/**",
      "functions/**",
      "vercel.json",
      "api/**",
      "lib/**",
      "users.json",
      "metas.json",
      "params.json",
      "fccommit.json",
      "fcparams.json",
      "data/history.json",
      "data/forecast-*.json",
      "data/filters.json",
      "data/daily.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api",
        "region": "southamerica-east1"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}
